{
  "info": {
    "name": "EventHub Experiment 6 \u2014 JWT and RBAC",
    "description": "Run numbered requests one at a time. Collection pre-request script generates two random demo passwords locally. Public registration is always a normal user. Promote candidate locally before request 08. NEVER publish tokens or passwords.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('userPassword')) pm.collectionVariables.set('userPassword', 'E6-' + pm.variables.replaceIn('{{$guid}}') + '!A1');",
          "if (!pm.collectionVariables.get('adminPassword')) pm.collectionVariables.set('adminPassword', 'E6-' + pm.variables.replaceIn('{{$guid}}') + '!A1');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 REGISTER normal user \u2014 Screenshot 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Akshat Korde\",\n  \"email\": \"student.exp6@example.test\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 LOGIN normal user \u2014 Screenshot 2",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student.exp6@example.test\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200){pm.collectionVariables.set(\"userToken\",pm.response.json().token)}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 GET current user with token \u2014 Screenshot 3",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "04 LOGIN invalid credentials \u2014 Screenshot 4",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student.exp6@example.test\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 GET current user without token \u2014 Screenshot 5",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "06 GET admin overview as normal user \u2014 Screenshot 6",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "07 REGISTER admin candidate (normal user initially)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"EventHub Administrator\",\n  \"email\": \"admin.exp6@example.test\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 LOGIN admin AFTER LOCAL PROMOTION \u2014 keep token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin.exp6@example.test\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200){pm.collectionVariables.set(\"adminToken\",pm.response.json().token)}"
            ]
          }
        }
      ]
    },
    {
      "name": "09 GET admin overview with admin token \u2014 Screenshot 7",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/overview"
      }
    },
    {
      "name": "10 POST event with admin token (optional test)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/events",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"JWT Admin Demo Event\",\n  \"description\": \"Created by an authorized administrator.\",\n  \"date\": \"28 November 2026\",\n  \"location\": \"Mumbai\",\n  \"category\": \"Workshop\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ]
}